-- ESP ──────────────────────────────────────
local function ClearESP()
    for _, obj in pairs(ESPBillboards) do
        pcall(function() obj:Destroy() end)
    end
    ESPBillboards = {}
end

local function AddESP(plr)
    if plr == LocalPlayer then return end
    local function TryBuild()
        local char = plr.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local bb = Instance.new("BillboardGui")
        bb.Name          = "NOXIN_ESP"
        bb.Adornee       = root
        bb.AlwaysOnTop   = true
        bb.Size          = UDim2.fromOffset(100, 30)
        bb.StudsOffset   = Vector3.new(0, 3, 0)
        bb.Parent        = root

        local nameLabel = Instance.new("TextLabel", bb)
        nameLabel.Size           = UDim2.fromScale(1, 0.6)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextColor3     = Color3.fromRGB(60,180,255)
        nameLabel.TextSize       = 11
        nameLabel.Font           = Enum.Font.GothamBold
        nameLabel.Text           = plr.Name

        local healthLabel = Instance.new("TextLabel", bb)
        healthLabel.Name         = "HP"
        healthLabel.Size         = UDim2.fromScale(1,0.4)
        healthLabel.Position     = UDim2.fromScale(0,0.6)
        healthLabel.BackgroundTransparency = 1
        healthLabel.TextColor3   = Color3.fromRGB(100,255,100)
        healthLabel.TextSize     = 9
        healthLabel.Font         = Enum.Font.Gotham
        healthLabel.Text         = "HP: ?"

        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            healthLabel.Text = "HP: "..math.floor(hum.Health)
            hum.HealthChanged:Connect(function(h)
                healthLabel.Text = "HP: "..math.floor(h)
            end)
        end

        -- Box highlight
        local hl = Instance.new("SelectionBox")
        hl.Adornee        = char
        hl.Color3         = Color3.fromRGB(60,180,255)
        hl.LineThickness  = 0.04
        hl.SurfaceTransparency = 1
        hl.Parent         = char

        ESPBillboards[plr] = bb
    end

    TryBuild()
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        TryBuild()
    end)
end

local function ESPCallback(state)
    if state then
        for _, p in ipairs(Players:GetPlayers()) do AddESP(p) end
        Players.PlayerAdded:Connect(function(p) if Flags.ESPPlayers then AddESP(p) end end)
    else
        ClearESP()
    end
end

-- Silent Aim ───────────────────────────────
local SilentAimConn
local function SilentAimCallback(state)
    if SilentAimConn then SilentAimConn:Disconnect(); SilentAimConn = nil end
    if not state then return end

    local function NearestTarget()
        local closest, dist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                local hum  = p.Character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local spos, vis = Camera:WorldToViewportPoint(root.Position)
                    if vis then
                        local d = (Vector2.new(spos.X, spos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                        if d < dist then closest, dist = root, d end
                    end
                end
            end
        end
        return closest
    end

    SilentAimConn = RunService.RenderStepped:Connect(function()
        if not Flags.SilentAim then return end
        local target = NearestTarget()
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        end
    end)
end

-- Rapid Fire ───────────────────────────────
local RFConn
local function RapidFireCallback(state)
    if RFConn then RFConn:Disconnect(); RFConn = nil end
    if not state then return end
    -- Hooks mouse-down to auto-click at high rate
    RFConn = RunService.Heartbeat:Connect(function()
        if Flags.RapidFire then
            mouse1click()  -- executor function (syn/fluxus compatible)
        end
    end)
end

-- No Recoil ────────────────────────────────
local NoRecoilConn
local function NoRecoilCallback(state)
    if NoRecoilConn then NoRecoilConn:Disconnect(); NoRecoilConn = nil end
    if not state then return end
    NoRecoilConn = RunService.RenderStepped:Connect(function()
        if Flags.NoRecoil then
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    -- Neutralise vertical camera drift
                    local cf  = Camera.CFrame
                    local rx, ry, rz = cf:ToEulerAnglesYXZ()
                    Camera.CFrame = CFrame.fromEulerAnglesYXZ(
                        math.clamp(rx, math.rad(-5), math.rad(5)), ry, rz
                    ) + cf.Position - cf.Position
                end
            end
        end
    end)
end

-- Noclip ───────────────────────────────────
local function NoclipCallback(state)
    if NoclipConn then NoclipConn:Disconnect(); NoclipConn = nil end
    if not state then
        -- re-enable collisions
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
        end
        return
    end
    NoclipConn = RunService.Stepped:Connect(function()
        if not Flags.Noclip then return end
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)
end

